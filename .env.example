# ====================================================================
# Library Management System (LMS) - Environment Configuration Template
# ====================================================================
# Copy this file to '.env' and update the values for your local environment:
#   copy .env.example .env

# Server Port and Mode
PORT=3000
NODE_ENV=development

# Session Encryption Key (Change this in production)
SESSION_SECRET=lms_super_secret_session_key_change_in_production_2026

# Standalone MySQL 8.0 Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=lms_db
DB_CONNECTION_LIMIT=10

# Academic Library Business Rules
LOAN_PERIOD_DAYS=14
FINE_RATE_PER_DAY=5.00
MAX_BOOKS_PER_STUDENT=3
